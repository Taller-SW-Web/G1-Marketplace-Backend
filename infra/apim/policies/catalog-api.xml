<!--
  Candidate API-scope policy for #310. APIM #307 closed on 2026-11-23 and
  Consumption is Online, but this policy has not been validated in that
  instance. Do not deploy without express authorization.

  catalogCacheScope is intentionally only a route/method/authentication allowlist;
  this policy has no active cache lookup or cache store. The current catalog
  OpenAPI and runtime both require Cache-Control: no-store. See
  docs/APIM-POLICY-H5-310.md before any APIM-specific activation.
-->
<policies>
  <inbound>
    <base />

    <!-- Match the BFF contract: retain a safe caller ID; otherwise use APIM's request ID. -->
    <set-variable name="requestId" value="@{
      var supplied = context.Request.Headers.GetValueOrDefault(&quot;X-Request-Id&quot;, &quot;&quot;);
      return System.Text.RegularExpressions.Regex.IsMatch(supplied, &quot;^[A-Za-z0-9._-]{1,64}$&quot;)
        ? supplied
        : context.RequestId.ToString();
    }" />
    <set-header name="X-Request-Id" exists-action="override">
      <value>@((string)context.Variables[&quot;requestId&quot;])</value>
    </set-header>

    <!-- Exact public GET paths from docs/contratos/openapi-catalogo-h4.json. -->
    <set-variable name="catalogCacheScope" value="@(
      context.Request.Method == &quot;GET&quot; &amp;&amp;
      (context.Request.Url.Path == &quot;/api/v1/catalog/home&quot; ||
       context.Request.Url.Path == &quot;/api/v1/catalog/filters&quot; ||
       context.Request.Url.Path == &quot;/api/v1/catalog/products&quot;) &amp;&amp;
      !context.Request.Headers.ContainsKey(&quot;Authorization&quot;) &amp;&amp;
      !context.Request.Headers.ContainsKey(&quot;Cookie&quot;)
    )" />
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
    <!-- Keep the same ID visible to the caller; the BFF also emits this header. -->
    <set-header name="X-Request-Id" exists-action="override">
      <value>@((string)context.Variables[&quot;requestId&quot;])</value>
    </set-header>
  </outbound>

  <on-error>
    <base />
    <set-header name="X-Request-Id" exists-action="override">
      <value>@(context.Variables.ContainsKey(&quot;requestId&quot;)
        ? (string)context.Variables[&quot;requestId&quot;]
        : context.RequestId.ToString())</value>
    </set-header>
  </on-error>
</policies>
