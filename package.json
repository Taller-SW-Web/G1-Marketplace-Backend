{
  "name": "g1-marketplace-backend",
  "version": "1.0.0",
  "description": "Backend Marketplace Multicanal - NestJS & Prisma ORM",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "npm run test:unit && npm run test:e2e && npm run test:mock-auth && npm run test:g6:probe",
    "mock:auth": "node scripts/mock-auth-server.mjs",
    "test:mock-auth": "node --test scripts/mock-auth-server.test.mjs",
    "test:unit": "jest --runInBand",
    "test:integration": "ts-node scripts/integration-test.ts",
    "test:diego:isolated": "node scripts/test-diego-isolated.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sandbox:token": "ts-node scripts/sandbox-token.ts",
    "sandbox:fixtures": "ts-node scripts/wishlist-fixtures.ts",
    "docs:openapi": "ts-node scripts/openapi.ts",
    "test:smoke": "ts-node scripts/smoke-h3.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "lint": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:resolve": "prisma migrate resolve --applied 0_init",
    "prisma:pull": "prisma db pull",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "test:g6:contract": "jest --config ./test/jest-e2e.json --runInBand test/catalog-g6-contract.e2e-spec.ts test/catalog-g6-demo.e2e-spec.ts",
    "test:g6:probe": "node --test scripts/check-g6.test.mjs",
    "check:g6": "node scripts/check-g6.mjs"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^5.20.0",
    "axios-mock-adapter": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^18.0.8",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    }
  },
  "engines": {
    "node": ">=22 <25"
  }
}
