<!--
  Política Global / API para Azure API Management (Plan Consumption)
  Tarea: TASK-H5-APIM-003 / TASK-H5-APIM-004 / TASK-H5-APIM-006 (Issues #309, #310, #311)
  Controles:
  - Trazabilidad unificada: X-Correlation-Id (oficial) + alias sincronizado X-Request-Id
  - CORS hacia el frontend de Vercel
  - Rate Limiting por suscripción (60 peticiones/minuto -> HTTP 429)
  - Validación de JWT RS256 contra OIDC/JWKS de G7 (-> HTTP 401 en rutas protegidas)
  - Rewrite /v1/{ruta} -> /api/v1/{ruta} excluyendo /health y /docs (preservando query params)
  - Caché deshabilitada por defecto (Cache-Control: no-store)
-->
<policies>
    <inbound>
        <base />

        <!-- 1. Trazabilidad: conservar o generar X-Correlation-Id y sincronizar alias X-Request-Id -->
        <set-variable name="correlationId" value='@(context.Request.Headers.GetValueOrDefault("X-Correlation-Id", context.Request.Headers.GetValueOrDefault("X-Request-Id", Guid.NewGuid().ToString())))' />
        <set-header name="X-Correlation-Id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>
        <set-header name="X-Request-Id" exists-action="override">
            <value>@((string)context.Variables["correlationId"])</value>
        </set-header>

        <!-- 2. Configuración de CORS hacia Vercel y desarrollo local -->
        <cors allow-credentials="true">
            <allowed-origins>
                <origin>https://g1-marketplace-frontend.vercel.app</origin>
                <origin>http://localhost:3000</origin>
            </allowed-origins>
            <allowed-methods preflight-result-max-age="300">
                <method>GET</method>
                <method>POST</method>
                <method>PUT</method>
                <method>PATCH</method>
                <method>DELETE</method>
                <method>OPTIONS</method>
            </allowed-methods>
            <allowed-headers>
                <header>*</header>
            </allowed-headers>
            <expose-headers>
                <header>X-Correlation-Id</header>
                <header>X-Request-Id</header>
                <header>Retry-After</header>
            </expose-headers>
        </cors>

        <!-- 3. Rate Limiting (Plan Consumption): Máximo 60 llamadas por minuto por suscripción (HTTP 429) -->
        <rate-limit calls="60" renewal-period="60" retry-after-header-name="Retry-After" />

        <!-- 4. Validación de Token JWT (G7 Auth Service) en rutas protegidas -->
        <choose>
            <!-- Omitir validación en rutas públicas: health, catálogo público, docs de Swagger, preflight -->
            <when condition='@(context.Request.OriginalUrl.Path.ToLower().Contains("/health") || 
                               context.Request.OriginalUrl.Path.ToLower().Contains("/docs") || 
                               context.Request.OriginalUrl.Path.ToLower().Contains("/catalog") || 
                               context.Request.Method == "OPTIONS")'>
                <!-- Ruta pública: permitir paso directo -->
            </when>
            <otherwise>
                <validate-jwt header-name="Authorization" failed-validation-httpcode="401" 
                              failed-validation-error-message="Acceso no autorizado: Token JWT invalido, expirado o ausente">
                    <openid-config url="https://g7-auth-service.onrender.com/api/v1/auth/.well-known/openid-configuration" />
                    <issuers>
                        <issuer>https://g7-auth-service.onrender.com/api/v1/auth</issuer>
                    </issuers>
                </validate-jwt>
            </otherwise>
        </choose>

        <!-- 5. Rewrite /v1/{ruta} -> /api/v1/{ruta} para rutas de negocio (excluye /health, /docs y /api/*) -->
        <choose>
            <when condition='@(!context.Request.Url.Path.ToLower().StartsWith("/health") &amp;&amp; !context.Request.Url.Path.ToLower().StartsWith("/docs") &amp;&amp; !context.Request.Url.Path.ToLower().StartsWith("/api/"))'>
                <rewrite-uri template='@("/api/v1" + context.Request.Url.Path)' copy-unmatched-params="true" />
            </when>
        </choose>
    </inbound>

    <backend>
        <base />
    </backend>

    <outbound>
        <base />
        <!-- Reflejar el mismo UUID en X-Correlation-Id y X-Request-Id + no-store -->
        <set-header name="X-Correlation-Id" exists-action="override">
            <value>@((string)context.Variables.GetValueOrDefault("correlationId", Guid.NewGuid().ToString()))</value>
        </set-header>
        <set-header name="X-Request-Id" exists-action="override">
            <value>@((string)context.Variables.GetValueOrDefault("correlationId", Guid.NewGuid().ToString()))</value>
        </set-header>
        <set-header name="Cache-Control" exists-action="skip">
            <value>no-store</value>
        </set-header>
    </outbound>

    <on-error>
        <base />
        <set-header name="X-Correlation-Id" exists-action="override">
            <value>@((string)context.Variables.GetValueOrDefault("correlationId", Guid.NewGuid().ToString()))</value>
        </set-header>
        <set-header name="X-Request-Id" exists-action="override">
            <value>@((string)context.Variables.GetValueOrDefault("correlationId", Guid.NewGuid().ToString()))</value>
        </set-header>
    </on-error>
</policies>
