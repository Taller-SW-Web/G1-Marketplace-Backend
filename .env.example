# Credenciales de PostgreSQL local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=marketplace_db
POSTGRES_PORT=5432

# URL de conexión para Prisma y backend local
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/marketplace_db?schema=public"

# Orígenes web permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# Sólo para la demostración local H3 de F-002; siempre deshabilitado en producción.
H3_AUTH_MOCK=false

# F-028 H3: fixture explicitly enabled for local development only.
# Do not use mock identity or fixture data in production.
ORDERS_SOURCE=unconfigured
# Selects a fixed synthetic principal on the server when using the mock.
ORDERS_MOCK_CUSTOMER_ID=customer-demo-001

# Checkout y Carrito local: validación Bearer RS256 (npm run mock:auth)
NODE_ENV=development
USE_MOCKS=true
HTTP_TIMEOUT_MS=3000

# Validación Bearer RS256 local. En otra terminal ejecutar: npm run mock:auth
# El emisor de prueba sólo escucha en loopback y no representa a Seguridad.
AUTH_ISSUER=http://127.0.0.1:4010
AUTH_JWKS_URL=http://127.0.0.1:4010/jwks

# Fixtures optativas: PENDING | PAID | REJECTED para resultado de Ventas.
MOCK_SALES_OUTCOME=PENDING
# Escenarios: MOCK_ADDRESS_SCENARIO=EMPTY|UNAVAILABLE|TIMEOUT
# MOCK_QUOTE_SCENARIO=NO_COVERAGE|UNAVAILABLE|TIMEOUT
# MOCK_BENEFIT_SCENARIO=UNAVAILABLE|TIMEOUT
# MOCK_INVENTORY_SCENARIO=UNAVAILABLE|TIMEOUT
# MOCK_SALES_SCENARIO=UNAVAILABLE|POST_TIMEOUT|STATUS_TIMEOUT
