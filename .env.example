# Credenciales de PostgreSQL local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=marketplace_db
POSTGRES_PORT=5432

# URL de conexión para Prisma y backend local
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/marketplace_db?schema=public"

# Orígenes web permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# Checkout y Carrito local: validación Bearer RS256 (npm run mock:auth)
NODE_ENV=development
USE_MOCKS=true
HTTP_TIMEOUT_MS=3000
AUTH_ISSUER=http://127.0.0.1:4010
AUTH_JWKS_URL=http://127.0.0.1:4010/jwks

# F-006/F-007: unconfigured by default; mock only for local development.
CATALOG_SOURCE=unconfigured
PORT=10000
# Real mode requires an approved contract, environment, token and media hosts.
# CATALOG_INTEGRATION_APPROVED=true
# PRODUCTOS_BASE_URL=https://HOST_APROBADO
# PRODUCTOS_SERVICE_TOKEN=
# PRODUCTOS_CONTRACT_VERSION=0.6.0-rc.1
# PRODUCTOS_CONTRACT_SHA=f64bfe9a097b2a0f74c2600988305443d92f640e
# PRODUCTOS_MEDIA_HOSTS=
PRODUCTOS_TIMEOUT_MS=5000

# G6 origin communicated for H3: https://g6-productos-ofertas.duckdns.org
# Keep CATALOG_SOURCE=mock in the default Docker demo. REAL uses compose.h3.g6.yaml.
# G6/G7 must confirm the service token, catalogo:leer, api-productos and client identity.
# The configured token is static; agree its acquisition/renewal before live integration.
# See docs/INTEGRACION-G6-H3.md; never store the real token in this example.
