# Credenciales de PostgreSQL local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=marketplace_db
POSTGRES_PORT=5432

# ─── BFF Catálogo (F-011) ───────────────────────────────────
# Modo de operación del BFF: 'mock' (fixture H3) | 'real' (post I-01)
# ⚠️ Mantener en 'mock' mientras I-01 esté bloqueado
BFF_MODE=mock

# URL de conexión para Prisma y backend local
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/marketplace_db?schema=public"

# Orígenes web permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# Sólo para la demostración local H3 de F-002; siempre deshabilitado en producción.
H3_AUTH_MOCK=false

# H4 G7: activar únicamente en el entorno acordado, sin mocks de identidad.
AUTH_ENABLED=false
G7_REGISTRATION_ENABLED=false
G7_RECOVERY_ENABLED=false
G7_INTROSPECTION_ENABLED=false
# Activar sólo tras confirmar cliente G1, tokens:introspeccion, audiencia api-seguridad y entorno G7.
G7_SERVICE_CLIENT_ID=
G7_SERVICE_CLIENT_SECRET=
# Mantener ambos bloques apagados hasta publicación y prueba conjunta con G7.
G7_API_URL=https://g7-auth-service.onrender.com/api/v1
G1_WEB_ORIGIN=http://127.0.0.1:3000
# Generar 32 bytes aleatorios base64 en el gestor privado de secretos.
# Cambiar la clave invalida todas las sesiones existentes.
AUTH_SESSION_KEY=
# Con AUTH_ENABLED=true, quitar AUTH_ISSUER/AUTH_JWKS_URL locales de abajo
# o fijarlos al issuer/JWKS G7; por defecto se derivan de G7_API_URL.

# F-028 H3: fixture explicitly enabled for local development only.
# Do not use mock identity or fixture data in production.
ORDERS_SOURCE=unconfigured
# Selects a fixed synthetic principal on the server when using the mock.
ORDERS_MOCK_CUSTOMER_ID=customer-demo-001

# H3: solo sandbox local. Generar secreto propio de al menos 32 bytes.
NODE_ENV=development
H3_SANDBOX_ENABLED=false
H3_JWT_SECRET=
# CORS_ALLOWED_ORIGINS tiene precedencia sobre CORS_ORIGINS si está definida.
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# Solo DB temporal local; nunca usar la base de desarrollo para las pruebas.
TEST_DATABASE_URL="postgresql://h3_test:h3_local_test_only@127.0.0.1:55432/marketplace_h3_test?schema=public"

# Checkout y Carrito local: validación Bearer RS256 (npm run mock:auth)
USE_MOCKS=true
HTTP_TIMEOUT_MS=3000

# Validación Bearer RS256 local. En otra terminal ejecutar: npm run mock:auth
# El emisor de prueba sólo escucha en loopback y no representa a Seguridad.
AUTH_ISSUER=http://127.0.0.1:4010
AUTH_JWKS_URL=http://127.0.0.1:4010/jwks

# F-006/F-007: unconfigured by default; mock only for local development.
CATALOG_SOURCE=unconfigured
PORT=10000
# Real mode requires an approved contract and environment. Service-token is the default.
# Explicit temporary G6 demo mode (PR #130): PRODUCTOS_AUTH_MODE=demo-no-auth.
# That mode omits Authorization and needs no token; service-token still requires it.
PRODUCTOS_AUTH_MODE=service-token
# CATALOG_INTEGRATION_APPROVED=true
# PRODUCTOS_BASE_URL=https://HOST_APROBADO
# PRODUCTOS_SERVICE_TOKEN=
# PRODUCTOS_CONTRACT_VERSION=0.6.0-rc.1
# PRODUCTOS_CONTRACT_SHA=f64bfe9a097b2a0f74c2600988305443d92f640e
# PRODUCTOS_MEDIA_HOSTS=
PRODUCTOS_TIMEOUT_MS=5000

# G6 origin communicated for H3: https://g6-productos-ofertas.duckdns.org
# Keep CATALOG_SOURCE=mock in the default Docker demo. REAL uses compose.h3.g6.yaml.
# In service-token mode G6/G7 must confirm the token, catalogo:leer, api-productos and client identity.
# The configured token is static; agree its acquisition/renewal before live integration.
# See docs/INTEGRACION-G6-H3.md; never store the real token in this example.

# Fixtures optativas: PENDING | PAID | REJECTED para resultado de Ventas.
MOCK_SALES_OUTCOME=PENDING
# Escenarios: MOCK_ADDRESS_SCENARIO=EMPTY|UNAVAILABLE|TIMEOUT
# MOCK_QUOTE_SCENARIO=NO_COVERAGE|UNAVAILABLE|TIMEOUT
# MOCK_BENEFIT_SCENARIO=UNAVAILABLE|TIMEOUT
# MOCK_INVENTORY_SCENARIO=UNAVAILABLE|TIMEOUT
# MOCK_SALES_SCENARIO=UNAVAILABLE|POST_TIMEOUT|STATUS_TIMEOUT
# Favoritos G6: apagado hasta revisión de contrato, grants y prueba conjunta.
WISHLIST_SOURCE=sandbox
WISHLIST_G6_APPROVED=false
WISHLIST_G6_REVISION=599c34f4e677c8792532e2cc31ac372473a10710
WISHLIST_G6_QUANTITY_APPROVED=false
# Referencia pública de fulfillment aprobada por G6; no warehouse/location interno.
WISHLIST_FULFILLMENT_REF=

# CSAT: I-03/I-04 y ciclo de prompt G-PROMPT pendientes. Nunca habilitar por copiar este archivo.
CSAT_ENABLED=false
CSAT_INTEGRATION_APPROVED=false
CSAT_PROMPT_APPROVED=false
CSAT_SALES_BASE_URL=
CSAT_POSTVENTA_BASE_URL=
