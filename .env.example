# ========================================================
# VARIABLES DE ENTORNO — MARKETPLACE BACKEND
# ========================================================

# Servidor y Red
PORT=10000
NODE_ENV=development
# URL permitida del Frontend Next.js (sin wildcard '*' en producción)
CORS_ORIGIN="http://localhost:3000"

# Credenciales de PostgreSQL local (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Conexión de Prisma ORM
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/marketplace_db?schema=public"

# ========================================================
# INTEGRACIONES EXTERNAS (HITO 3)
# ========================================================
# Módulo de Productos y Catálogo (G6 - Integración I-01)
PRODUCTOS_BASE_URL="https://api-productos-example.onrender.com"
PRODUCTOS_TIMEOUT_MS=5000

# Módulo de Seguridad y Usuarios (Autenticación de servicio)
AUTH_SERVICE_URL="https://api-seguridad-example.onrender.com"
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""
