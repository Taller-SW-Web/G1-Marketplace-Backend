# Credenciales de PostgreSQL local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=marketplace_db
POSTGRES_PORT=5432

# URL de conexión para Prisma y backend local
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/marketplace_db?schema=public"

# Orígenes web permitidos separados por coma
CORS_ORIGINS=http://localhost:3000

# F-028 H3: fixture explicitly enabled for local development only.
# Do not use mock identity or fixture data in production.
ORDERS_SOURCE=unconfigured
# Selects a fixed synthetic principal on the server when using the mock.
ORDERS_MOCK_CUSTOMER_ID=customer-demo-001
