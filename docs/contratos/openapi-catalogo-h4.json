{
  "openapi": "3.1.0",
  "info": {
    "title": "Marketplace — Catálogo H4 (F-006–F-010)",
    "version": "0.2.0",
    "description": "Contrato G1 implementado para revisión. Catálogo público; identidad técnica G1→G6 sólo en servidor. No acredita homologación ni despliegue."
  },
  "servers": [
    {
      "url": "/",
      "description": "Origen del BFF desplegado o local"
    }
  ],
  "paths": {
    "/api/v1/catalog/home": {
      "get": {
        "operationId": "catalogHome",
        "tags": [
          "Catalog"
        ],
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lectura pública válida; arreglos vacíos permitidos",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Catalog-Source": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "MOCK",
                    "REAL",
                    "UNCONFIGURED"
                  ]
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Home"
                }
              }
            }
          },
          "400": {
            "description": "Criterios inválidos antes del proveedor",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Catalog-Source": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "MOCK",
                    "REAL",
                    "UNCONFIGURED"
                  ]
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "CATALOG_TIMEOUT: presupuesto de espera agotado; CATALOG_UNAVAILABLE: otro fallo. Sin fallback MOCK",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Catalog-Source": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "MOCK",
                    "REAL",
                    "UNCONFIGURED"
                  ]
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog/filters": {
      "get": {
        "operationId": "catalogFilters",
        "tags": [
          "Catalog"
        ],
        "security": [],
        "parameters": [],
