                  ]
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Filters"
                }
              }
            }
          },
          "400": {
            "description": "Criterios inválidos antes del proveedor",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Catalog-Source": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "MOCK",
                    "REAL",
                    "UNCONFIGURED"
                  ]
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string",
