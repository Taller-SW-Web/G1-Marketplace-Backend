{
  "openapi": "3.1.0",
  "info": {
    "title": "Productos y Ofertas — extracto H5",
    "version": "0.6.0-rc.1"
  },
  "paths": {
    "/productos": {
      "get": {
        "operationId": "listarProductos",
        "x-status": "stable",
        "x-service-audience": "api-productos",
        "x-required-scope": "catalogo:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          { "userBearer": [] },
          { "serviceBearer": [] }
        ],
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "categoriaId", "in": "query", "schema": { "type": "string" } },
          { "name": "marcaId", "in": "query", "schema": { "type": "string" } },
          { "name": "canal", "in": "query", "schema": { "$ref": "#/components/schemas/Canal" } },
          { "name": "pagina", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "tamanio", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "estado", "in": "query", "schema": { "$ref": "#/components/schemas/EstadoProducto" } },
          { "name": "precioMin", "in": "query", "schema": { "type": "number", "minimum": 0 } },
          { "name": "precioMax", "in": "query", "schema": { "type": "number", "minimum": 0 } },
          { "name": "orden", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/OrdenCatalogo" } },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginaProductosComercial" } } } },
          "400": { "description": "Solicitud inválida" },
          "401": { "description": "No autenticado" },
          "403": { "description": "No autorizado" },
          "422": { "description": "Filtros inválidos" },
          "429": { "description": "Límite excedido" },
          "500": { "description": "Error interno" },
          "503": { "description": "Dependencia o servicio no disponible" }
        }
      }
    },
    "/productos/{productoId}": {
      "get": {
        "operationId": "obtenerProducto",
        "x-status": "stable",
        "x-service-audience": "api-productos",
        "x-required-scope": "catalogo:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          { "userBearer": [] },
          { "serviceBearer": [] }
        ],
        "parameters": [
          { "name": "productoId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "canal", "in": "query", "schema": { "$ref": "#/components/schemas/Canal" } },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductoDetalleComercial" } } } },
          "400": { "description": "Solicitud inválida" },
          "401": { "description": "No autenticado" },
          "403": { "description": "No autorizado" },
          "404": { "description": "Producto no encontrado" },
          "429": { "description": "Límite excedido" },
          "500": { "description": "Error interno" },
          "503": { "description": "Dependencia o servicio no disponible" }
        }
      }
    },
    "/productos/por-slug/{slug}": {
      "get": {
        "operationId": "obtenerProductoPorSlug",
        "x-status": "stable",
        "x-service-audience": "api-productos",
        "x-required-scope": "catalogo:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          { "serviceBearer": [] },
          { "userBearer": [] }
        ],
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "canal", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/Canal" } },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProductoDetalleComercial" } } } },
          "401": { "description": "No autenticado" },
          "403": { "description": "No autorizado" },
          "404": { "description": "Producto no encontrado" },
          "429": { "description": "Límite excedido" },
          "500": { "description": "Error interno" },
          "503": { "description": "Dependencia o servicio no disponible" }
        }
      }
    },
    "/precios/skus/{sku}": {
      "get": {
        "operationId": "obtenerPrecioSku",
        "x-status": "stable",
        "x-service-audience": "api-productos",
        "x-required-scope": "precios:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          { "userBearer": [] },
          { "serviceBearer": [] }
        ],
        "parameters": [
          { "name": "sku", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "canal", "in": "query", "schema": { "$ref": "#/components/schemas/Canal" } },
          { "name": "at", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Precio" } } } },
          "400": { "description": "Solicitud inválida" },
          "401": { "description": "No autenticado" },
          "403": { "description": "No autorizado" },
          "404": { "description": "SKU o precio no encontrado" },
          "429": { "description": "Límite excedido" },
          "500": { "description": "Error interno" },
          "503": { "description": "Dependencia o servicio no disponible" }
        }
      }
    },
    "/inventario/disponibilidad/comercial": {
      "get": {
        "operationId": "consultarDisponibilidadComercial",
        "x-status": "provisional",
        "x-service-audience": "api-productos",
        "x-required-scope": "inventario:disponibilidad:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [ { "serviceBearer": [] } ],
        "parameters": [
          { "name": "skus", "in": "query", "required": true, "style": "form", "explode": false, "schema": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 100 } },
          { "name": "canal", "in": "query", "required": true, "schema": { "$ref": "#/components/schemas/CanalComercial" } },
          { "$ref": "#/components/parameters/CorrelationId" }
        ],
        "responses": {
          "200": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ConsultaDisponibilidadComercialResponse" } } } },
          "400": { "description": "Solicitud inválida" },
          "401": { "description": "No autenticado" },
          "403": { "description": "No autorizado" },
          "429": { "description": "Límite excedido" },
          "500": { "description": "Error interno" },
          "503": { "description": "Servicio no disponible" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CorrelationId": { "name": "X-Correlation-Id", "in": "header", "required": false, "schema": { "type": "string", "format": "uuid" } }
    },
    "schemas": {
      "Canal": { "type": "string", "enum": ["MARKETPLACE", "CHATBOT", "RETAIL", "VENTAS"] },
      "CanalComercial": {
        "type": "string",
        "enum": ["MARKETPLACE", "CHATBOT", "RETAIL"],
        "description": "Canales autorizados para consultar proyecciones comerciales de inventario. El canal solicitado debe corresponder al client_id autenticado: modulo-marketplace -> MARKETPLACE, modulo-chatbot -> CHATBOT, modulo-retail -> RETAIL. Reglas deterministas de error: - 400 + VALIDACION: el valor de canal o channel_id no pertenece al enum MARKETPLACE, CHATBOT, RETAIL, o existe un error de formato de la solicitud. - 403 + SCOPE_INSUFICIENTE: el canal solicitado es válido, pero no corresponde al client_id autenticado, o la identidad carece de autorización para la operación."
      },
      "EstadoProducto": { "type": "string", "enum": ["BORRADOR", "ACTIVO", "INACTIVO"] },
      "OrdenCatalogo": { "type": "string", "enum": ["NOMBRE_ASC", "NOMBRE_DESC"] },
      "ProductoResumenComercial": {
        "type": "object",
        "properties": {
          "product_id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "categoria_id": { "type": "string" },
          "tipo_producto_id": { "type": "string" },
          "marca_id": { "type": "string" },
          "tiene_variantes": { "type": "boolean" },
          "sku_base": { "type": ["string", "null"] },
          "images": { "type": "array", "items": { "type": "string", "format": "uri" } }
        },
        "required": ["product_id", "slug", "name", "categoria_id", "tipo_producto_id", "marca_id", "tiene_variantes"]
      },
      "PaginaProductosComercial": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/ProductoResumenComercial" } },
          "pagina": { "type": "integer", "minimum": 1 },
          "tamanio": { "type": "integer", "minimum": 1 },
          "total": { "type": "integer", "minimum": 0 }
        },
        "required": ["items", "pagina", "tamanio", "total"]
      },
      "ProductoDetalleComercial": {
        "allOf": [
          { "$ref": "#/components/schemas/ProductoResumenComercial" },
          {
            "type": "object",
            "properties": {
              "marca": { "$ref": "#/components/schemas/MarcaComercial" },
              "variants": { "type": "array", "items": { "$ref": "#/components/schemas/VarianteComercial" } }
            },
            "required": ["marca", "variants"]
          }
        ]
      },
      "MarcaComercial": {
        "type": "object",
        "properties": {
          "marca_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "logo_url": { "type": ["string", "null"], "format": "uri" },
          "country_code": { "type": ["string", "null"] }
        },
        "required": ["marca_id", "name"]
      },
      "VarianteComercial": {
        "type": "object",
        "properties": {
          "variant_id": { "type": "string" },
          "sku": { "type": "string" },
          "identifying_attributes": { "type": "array", "items": { "$ref": "#/components/schemas/Atributo" } },
          "non_identifying_attributes": { "type": "array", "items": { "$ref": "#/components/schemas/Atributo" } },
          "images": { "type": "array", "items": { "type": "string", "format": "uri" } }
        },
        "required": ["variant_id", "sku"]
      },
      "Atributo": {
        "type": "object",
        "properties": {
          "caracteristica_id": { "type": "string" },
          "nombre": { "type": "string" },
          "valor_id": { "type": ["string", "null"] },
          "valor": {}
        },
        "required": ["caracteristica_id", "nombre", "valor"]
      },
      "Precio": {
        "type": "object",
        "properties": {
          "sku": { "type": "string" },
          "precio_regular": { "type": "number", "exclusiveMinimum": 0 },
          "precio_oferta": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "currency": { "type": "string", "default": "PEN" },
          "channel_id": { "oneOf": [{ "$ref": "#/components/schemas/Canal" }, { "type": "null" }] },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_until": { "type": ["string", "null"], "format": "date-time" },
          "price_version": { "type": "integer", "minimum": 0 },
          "vigencia_id": { "type": "string", "minLength": 1 },
          "origen": { "type": "string", "enum": ["PRODUCTO", "SKU_OVERRIDE"] }
        },
        "required": ["sku", "precio_regular", "currency", "channel_id", "valid_from", "price_version", "vigencia_id", "origen"]
      },
      "DisponibilidadComercial": {
        "type": "object",
        "properties": {
          "sku": { "type": "string" },
          "status": { "type": "string", "enum": ["DISPONIBLE", "STOCK_BAJO", "AGOTADO", "INDETERMINADO"] }
        },
        "required": ["sku", "status"],
        "additionalProperties": false
      },
      "ConsultaDisponibilidadComercialResponse": {
        "type": "object",
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/DisponibilidadComercial" } } },
        "required": ["items"]
      }
    }
  }
}
