{
  "openapi": "3.1.0",
  "info": {
    "title": "Productos y Ofertas — extracto H5",
    "version": "0.7.0-rc.3"
  },
  "paths": {
    "/productos": {
      "get": {
        "operationId": "listarProductos",
        "x-status": "stable",
        "x-service-audience": "api-productos",
        "x-required-scope": "catalogo:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          {
            "userBearer": []
          },
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "categoriaId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "marcaId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tipoProductoIdsIncluidos",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          {
            "name": "tipoProductoIdsExcluidos",
            "in": "query",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          {
            "name": "canal",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Canal"
            }
          },
          {
            "name": "pagina",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "tamanio",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "estado",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/EstadoProducto"
            }
          },
          {
            "name": "precioMin",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "precioMax",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "orden",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrdenCatalogo"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de productos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginaProductosComercial"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "No autenticado"
          },
          "403": {
            "description": "No autorizado"
          },
          "422": {
            "description": "Filtros inválidos"
          },
          "429": {
            "description": ""
          },
          "500": {
            "description": "Error interno"
          },
          "503": {
            "description": "Dependencia o servicio no disponible"
          }
        }
      }
    },
    "/productos/{productoId}": {
      "get": {
        "operationId": "obtenerProducto",
        "x-status": "stable",
        "x-service-audience": "api-productos",
        "x-required-scope": "catalogo:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          {
            "userBearer": []
          },
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "name": "productoId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "canal",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Canal"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del producto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductoDetalleComercial"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "No autenticado"
          },
          "403": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Producto no encontrado"
          },
          "429": {
            "description": ""
          },
          "500": {
            "description": "Error interno"
          },
          "503": {
            "description": "Dependencia o servicio no disponible"
          }
        }
      }
    },
    "/productos/por-slug/{slug}": {
      "get": {
        "operationId": "obtenerProductoPorSlug",
        "x-status": "stable",
        "x-service-audience": "api-productos",
        "x-required-scope": "catalogo:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          {
            "serviceBearer": []
          },
          {
            "userBearer": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "canal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Canal"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Producto encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductoDetalleComercial"
                }
              }
            }
          },
          "401": {
            "description": "Error"
          },
          "403": {
            "description": "Error"
          },
          "404": {
            "description": "Error"
          },
          "429": {
            "description": ""
          },
          "500": {
            "description": "Error"
          },
          "503": {
            "description": "Error"
          }
        }
      }
    },
    "/precios/skus/{sku}": {
      "get": {
        "operationId": "obtenerPrecioSku",
        "x-status": "stable",
        "x-service-audience": "api-productos",
        "x-required-scope": "precios:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          {
            "userBearer": []
          },
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "name": "sku",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "canal",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Canal"
            }
          },
          {
            "name": "at",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Precio resuelto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Precio"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "No autenticado"
          },
          "403": {
            "description": "No autorizado"
          },
          "404": {
            "description": "SKU o precio no encontrado"
          },
          "429": {
            "description": ""
          },
          "500": {
            "description": "Error interno"
          },
          "503": {
            "description": "Dependencia o servicio no disponible"
          }
        }
      }
    },
    "/inventario/disponibilidad/comercial": {
      "get": {
        "operationId": "consultarDisponibilidadComercial",
        "x-status": "provisional",
        "x-service-audience": "api-productos",
        "x-required-scope": "inventario:disponibilidad:leer",
        "x-scope-registration-status": "pending-security-registration",
        "security": [
          {
            "serviceBearer": []
          }
        ],
        "parameters": [
          {
            "name": "skus",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "maxItems": 100
            }
          },
          {
            "name": "canal",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CanalComercial"
            }
          },
          {
            "name": "X-Correlation-Id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disponibilidad comercial",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultaDisponibilidadComercialResponse"
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida"
          },
          "401": {
            "description": "No autenticado"
          },
          "403": {
            "description": "No autorizado"
          },
          "429": {
            "description": ""
          },
          "500": {
            "description": "Error interno"
          },
          "503": {
            "description": "Servicio no disponible"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CorrelationId": {
        "name": "X-Correlation-Id",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "description": "Identificador de correlación extremo a extremo."
      }
    },
    "schemas": {
      "Canal": {
        "type": "string",
        "description": "Identificador comercial canónico de Pricing. El alcance global se expresa omitiendo canal y persiste como channel_id null; no es client_id de Seguridad.",
        "enum": [
          "MARKETPLACE",
          "CHATBOT",
          "RETAIL",
          "VENTAS"
        ]
      },
      "CanalComercial": {
        "type": "string",
        "enum": [
          "MARKETPLACE",
          "CHATBOT",
          "RETAIL"
        ],
        "description": "Canales autorizados para consultar proyecciones comerciales de inventario. Para clientes externos, el canal solicitado debe corresponder al client_id autenticado: modulo-marketplace -> MARKETPLACE, modulo-chatbot -> CHATBOT, modulo-retail -> RETAIL. El consumidor funcional previsto para la autorización interna del GET es Promotions, mediante la identidad compartida G6 modulo-productos. El JWT no identifica individualmente al bounded context; la política de Inventory restringe operación, cliente, scope y canal. Red privada y configuración de despliegue aíslan adicionalmente el origen. Combos conserva las reglas DEC-G6-INT-11; esta adenda no le concede capacidades. El POST verificador conserva exclusivamente los clientes comerciales indicados en su operación. Reglas deterministas de error: - 400 + VALIDACION: el valor de canal o channel_id no pertenece al enum MARKETPLACE, CHATBOT, RETAIL, o existe un error de formato de la solicitud. - 403 + SCOPE_INSUFICIENTE: el canal solicitado es válido, pero no corresponde al client_id autenticado, o la identidad carece de autorización para la operación."
      },
      "EstadoProducto": {
        "type": "string",
        "enum": [
          "BORRADOR",
          "ACTIVO",
          "INACTIVO"
        ]
      },
      "OrdenCatalogo": {
        "type": "string",
        "enum": [
          "NOMBRE_ASC",
          "NOMBRE_DESC"
        ],
        "description": "Ordenamiento contractual seguro a nivel de producto. El orden por precio permanece fuera mientras no exista una regla product-level."
      },
      "ProductoResumenComercial": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "categoria_id": {
            "type": "string"
          },
          "tipo_producto_id": {
            "type": "string"
          },
          "marca_id": {
            "type": "string"
          },
          "tiene_variantes": {
            "type": "boolean"
          },
          "sku_base": {
            "type": [
              "string",
              "null"
            ]
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Atributo"
            }
          }
        },
        "required": [
          "product_id",
          "slug",
          "name",
          "categoria_id",
          "tipo_producto_id",
          "marca_id",
          "tiene_variantes"
        ]
      },
      "PaginaProductosComercial": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductoResumenComercial"
            }
          },
          "pagina": {
            "type": "integer",
            "minimum": 1
          },
          "tamanio": {
            "type": "integer",
            "minimum": 1
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "pagina",
          "tamanio",
          "total"
        ]
      },
      "ProductoDetalleComercial": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProductoResumenComercial"
          },
          {
            "type": "object",
            "properties": {
              "marca": {
                "$ref": "#/components/schemas/MarcaComercial"
              },
              "variants": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VarianteComercial"
                }
              }
            },
            "required": [
              "marca",
              "variants"
            ]
          }
        ]
      },
      "MarcaComercial": {
        "type": "object",
        "properties": {
          "marca_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "country_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "marca_id",
          "name"
        ]
      },
      "VarianteComercial": {
        "type": "object",
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "identifying_attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Atributo"
            }
          },
          "non_identifying_attributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Atributo"
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "required": [
          "variant_id",
          "sku"
        ]
      },
      "Atributo": {
        "type": "object",
        "properties": {
          "caracteristica_id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "valor_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "valor": {}
        },
        "required": [
          "caracteristica_id",
          "nombre",
          "valor"
        ]
      },
      "Precio": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "precio_regular": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "precio_oferta": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "currency": {
            "type": "string",
            "default": "PEN"
          },
          "channel_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Canal"
              },
              {
                "type": "null"
              }
            ],
            "description": "Canal efectivo de la vigencia resuelta. Es null cuando el precio efectivo corresponde al alcance global."
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "price_version": {
            "type": "integer",
            "minimum": 0
          },
          "vigencia_id": {
            "type": "string",
            "minLength": 1,
            "description": "Identificador de la vigencia temporal que respalda el precio resuelto, incluidas las consultas históricas as-of."
          },
          "origen": {
            "type": "string",
            "enum": [
              "PRODUCTO",
              "SKU_OVERRIDE"
            ],
            "description": "Origen efectivo del precio: PRODUCTO cuando el SKU usa o hereda el precio base del producto; SKU_OVERRIDE cuando existe un precio específico del SKU."
          }
        },
        "required": [
          "sku",
          "precio_regular",
          "currency",
          "channel_id",
          "valid_from",
          "price_version",
          "vigencia_id",
          "origen"
        ]
      },
      "DisponibilidadComercial": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DISPONIBLE",
              "STOCK_BAJO",
              "AGOTADO",
              "INDETERMINADO"
            ],
            "description": "INDETERMINADO significa que no hay abastecimiento único verificable; nunca equivale a AGOTADO."
          }
        },
        "required": [
          "sku",
          "status"
        ],
        "additionalProperties": false
      },
      "ConsultaDisponibilidadComercialResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DisponibilidadComercial"
            }
          }
        },
        "required": [
          "items"
        ]
      }
    }
  }
}
