                }
              }
            }
          },
          "500": {
            "description": "Error interno del servicio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "Error interno del servicio"
                }
              }
            }
          },
          "503": {
            "description": "Proveedor no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "CATALOG_UNAVAILABLE": {
                    "value": {
                      "code": "CATALOG_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  },
                  "AUTH_UNAVAILABLE": {
                    "value": {
                      "code": "AUTH_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wishlist/items/{productId}": {
      "delete": {
        "operationId": "readdWishlistItemToCart",
        "tags": [
          "Wishlist"
        ],
        "summary": "F-038: eliminar favorito propio, sin consultar catálogo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "Sin espacios exteriores ni caracteres de control. Referencia textual, no SKU."
          }
        ],
        "responses": {
          "204": {
            "description": "Eliminado o ya ausente; sin cuerpo"
          },
          "400": {
            "description": "Identificador inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INVALID_PRODUCT_ID",
                  "message": "Identificador inválido"
                }
              }
            }
          },
          "401": {
            "description": "Autenticación requerida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "Autenticación requerida"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servicio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "Error interno del servicio"
                }
              }
            }
          },
          "503": {
            "description": "Proveedor no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "AUTH_UNAVAILABLE": {
                    "value": {
                      "code": "AUTH_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "readiness",
        "tags": [
          "System"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "PostgreSQL disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "UP",
                  "service": "g1-marketplace-backend",
                  "environment": "development",
                  "database": {
                    "connected": true
                  },
                  "timestamp": "2026-10-16T12:00:00.000Z"
                }
              }
            }
          },
          "503": {
            "description": "PostgreSQL no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                },
                "example": {
                  "status": "DOWN",
                  "service": "g1-marketplace-backend",
                  "environment": "development",
                  "database": {
                    "connected": false
                  },
                  "timestamp": "2026-10-16T12:00:00.000Z"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "SubmitCsat": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sentiment"
        ],
        "properties": {
          "sentiment": {
            "type": "string",
            "enum": [
              "GOOD",
              "REGULAR",
              "BAD"
            ]
          },
          "reasons": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,49}$"
            }
          },
          "comment": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "AddCartItemPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Identificador único del SKU del producto.",
            "example": "AERO-42-BLK"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "default": 1,
            "description": "Cantidad de unidades a sumar al carrito (entero entre 1 y 99).",
            "example": 1
          }
        }
      },
      "CartMutationResponse": {
        "type": "object",
        "required": [
          "status",
          "data"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ITEM_CREATED",
              "ITEM_INCREMENTED"
            ],
            "example": "ITEM_CREATED"
          },
          "data": {
            "$ref": "#/components/schemas/CartSnapshot"
          }
        }
      },
      "CartSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cartId",
          "version",
          "items"
        ],
        "properties": {
          "cartId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Identificador único UUID del carrito.",
            "example": "11111111-1111-4111-8111-111111111111"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "description": "Versión incremental del carrito para control de concurrencia optimista.",
            "example": 2
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CartItemSnapshot"
            }
          }
        }
      },
      "CartItemSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "quantity"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "example": "AERO-42-BLK"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99,
            "example": 1
          },
          "unitPrice": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "currency",
              "version"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0,
                "example": 89.9
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "example": "PEN"
              },
              "version": {
                "type": "integer",
                "minimum": 0,
                "example": 1
              }
            }
          }
        }
      },
      "WishlistItemView": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "createdAt",
          "name",
          "slug",
          "brand",
          "image",
          "price",
          "availability"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "nullable": true,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "brand": {
            "type": "string",
            "nullable": true,
            "minLength": 1
          },
          "image": {
            "type": "object",
            "nullable": true,
            "additionalProperties": false,
            "required": [
              "url",
              "alt"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "price": {
            "type": "object",
            "nullable": true,
            "additionalProperties": false,
            "required": [
              "amount",
              "currency"
            ],
            "properties": {
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            }
          },
          "availability": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "OUT_OF_STOCK",
              "UNAVAILABLE"
            ]
          }
        }
      },
      "AddFromWishlistResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId",
          "cart"
        ],
        "properties": {
          "productId": {
            "type": "string"
          },
          "cart": {
            "$ref": "#/components/schemas/CartSnapshot"
          }
        }
      },
      "VariantSelectionError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "redirectUrl"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VARIANT_SELECTION_REQUIRED"
            ]
          },
          "message": {
            "type": "string"
          },
          "redirectUrl": {
            "type": "string",
            "pattern": "^/productos/[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "WishlistItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "productId"
        ],
        "properties": {
          "productId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "PRD-1",
            "description": "Sin espacios exteriores ni caracteres de control; conserva capitalización."
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "environment",
          "database",
          "timestamp"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "service": {
            "type": "string",
            "example": "g1-marketplace-backend"
          },
          "environment": {
            "type": "string",
            "example": "development"
          },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "connected"
            ],
            "properties": {
              "connected": {
                "type": "boolean"
              }
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
