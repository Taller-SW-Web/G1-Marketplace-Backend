{
  "openapi": "3.0.3",
  "info": {
    "title": "Marketplace — API BFF Carrito y Favoritos (Hito 3 / Hito 4)",
    "version": "0.3.0",
    "description": "Especificación OpenAPI para las operaciones de Carrito de Compras (F-016 a F-021) y Favoritos (F-036 a F-039). Soporta autenticación dual: Bearer JWT (RS256) para clientes autenticados y cookie HttpOnly (cart_session) para invitados."
  },
  "servers": [
    {
      "url": "http://localhost:10000",
      "description": "Sandbox / Desarrollo local"
    },
    {
      "url": "https://g1-marketplace-backend.onrender.com",
      "description": "Servidor Render Producción"
    }
  ],
  "paths": {
    "/api/v1/orders/{orderId}/csat": {
      "post": {
        "operationId": "submitPostDeliveryCsat",
        "tags": [
          "CSAT"
        ],
        "summary": "F-040: evaluación de pedido entregado del titular",
        "description": "Desactivado por defecto. Requiere CSAT_ENABLED, CSAT_INTEGRATION_APPROVED y CSAT_PROMPT_APPROVED. Prompt propio SHOWN previamente autorizado; no crea ni muestra prompts. Conserva estado ante respuesta incierta, sin reintento automático. Cache-Control: no-store, private.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "pattern": "^PED-[0-9]{4}-[0-9]{5,}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitCsat"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ventas confirmó la evaluación; sin cuerpo. Prompt local SUBMITTED."
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INVALID_REQUEST",
                  "message": "Solicitud inválida"
                }
              }
            }
          },
          "401": {
            "description": "Autenticación requerida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "Autenticación requerida"
                }
              }
            }
          },
          "403": {
            "description": "Pedido ajeno",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "ORDER_FORBIDDEN",
                  "message": "Pedido ajeno"
                }
              }
            }
          },
          "404": {
            "description": "Pedido no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "ORDER_NOT_AVAILABLE",
                  "message": "Pedido no disponible"
                }
              }
            }
          },
          "409": {
            "description": "PROMPT_NOT_ELIGIBLE o CSAT_ALREADY_SUBMITTED. Sólo duplicado canónico confirmado por Ventas reconcilia el prompt."
          },
          "422": {
            "description": "Pedido no entregado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "ORDER_NOT_DELIVERED",
                  "message": "Pedido no entregado"
                }
              }
            }
          },
          "503": {
            "description": "Proveedor no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "CSAT_UNAVAILABLE": {
                    "value": {
                      "code": "CSAT_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  },
                  "SALES_UNAVAILABLE": {
                    "value": {
                      "code": "SALES_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  },
                  "AUTH_UNAVAILABLE": {
                    "value": {
                      "code": "AUTH_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/carts/current/items": {
      "post": {
        "operationId": "addCartItem",
        "tags": [
          "Cart"
        ],
        "summary": "F-016: Agregar ítem al carrito actual (alta o incremento)",
        "description": "Agrega 1 o más unidades de un SKU al carrito actual. Si el SKU no existe, crea la línea (201 ITEM_CREATED); si ya existe, incrementa la cantidad (200 ITEM_INCREMENTED). Se ejecuta de forma transaccional incrementando Cart.version y aplicando un lock exclusivo de PostgreSQL por titular. Ante usuario no autenticado, genera o renueva cookie Set-Cookie: cart_session=...; HttpOnly; SameSite=Lax.",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddCartItemPayload"
              },
              "example": {
                "sku": "AERO-42-BLK",
                "quantity": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Línea existente incrementada (ITEM_INCREMENTED).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartMutationResponse"
                },
                "example": {
                  "status": "ITEM_INCREMENTED",
                  "data": {
                    "cartId": "11111111-1111-4111-8111-111111111111",
                    "version": 3,
                    "items": [
                      {
                        "sku": "AERO-42-BLK",
                        "quantity": 2,
                        "unitPrice": {
                          "amount": 89.9,
                          "currency": "PEN",
                          "version": 1
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "201": {
            "description": "Nueva línea creada en el carrito (ITEM_CREATED).",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie de sesión anónima HttpOnly (solo para invitados)",
                "schema": {
                  "type": "string",
                  "example": "cart_session=uuid; Path=/; HttpOnly; SameSite=Lax"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CartMutationResponse"
                },
                "example": {
                  "status": "ITEM_CREATED",
                  "data": {
                    "cartId": "11111111-1111-4111-8111-111111111111",
                    "version": 2,
                    "items": [
                      {
                        "sku": "AERO-42-BLK",
                        "quantity": 1,
                        "unitPrice": {
                          "amount": 89.9,
                          "currency": "PEN",
                          "version": 1
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validación fallida: SKU ausente o cantidad fuera del rango permitido [1, 99].",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "invalidSku": {
                    "value": {
                      "code": "INVALID_SKU",
                      "message": "El parámetro sku es requerido."
                    }
                  },
                  "invalidQuantity": {
                    "value": {
                      "code": "INVALID_QUANTITY",
                      "message": "La cantidad debe ser un entero entre 1 y 99."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token de autenticación inválido, expirado o firma corrupta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "UNAUTHENTICATED",
                  "message": "Token de autenticación inválido, expirado o firma corrupta."
                }
              }
            }
          },
          "404": {
            "description": "Producto o SKU no disponible para venta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "SKU_NOT_AVAILABLE",
                  "message": "Producto o SKU no disponible para venta."
                }
              }
            }
          },
          "409": {
            "description": "Conflicto de negocio: límite de stock excedido o error de cotización.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "stockLimitReached": {
                    "value": {
                      "code": "STOCK_LIMIT_REACHED",
                      "message": "La cantidad excede el límite permitido de 99 unidades por ítem."
                    }
                  },
                  "commerceDataUnavailable": {
                    "value": {
                      "code": "COMMERCE_DATA_UNAVAILABLE",
                      "message": "Cotización no válida o datos comerciales no disponibles."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "Error interno del servidor."
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/carts/current": {
      "get": {
        "operationId": "getCurrentCart",
        "tags": [
          "Cart"
        ],
        "summary": "F-019: Obtener el carrito actual del titular o invitado",
        "description": "Recupera el snapshot del carrito activo asociado al customer_id (vía Bearer token) o a la sesión anónima (vía cookie cart_session). Devuelve items, cantidades, snapshots de precios y la versión actual.",
        "security": [
          {
            "bearerAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "Carrito recuperado exitosamente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "OK"
                    },
                    "data": {
                      "$ref": "#/components/schemas/CartSnapshot"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "Error interno del servidor."
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wishlist": {
      "get": {
        "operationId": "listWishlist",
        "tags": [
          "Wishlist"
        ],
        "summary": "F-037: favoritos del titular por createdAt DESC",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Arreglo confirmado; [] solo para lista vacía. Cache-Control: no-store, private.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WishlistItemView"
                  }
                },
                "example": [
                  {
                    "productId": "PRD-1",
                    "createdAt": "2026-10-16T12:00:00.000Z",
                    "name": "Producto de prueba",
                    "slug": "producto-de-prueba",
                    "brand": "Marca sandbox",
                    "image": null,
                    "price": {
                      "amount": 89.9,
                      "currency": "PEN"
                    },
                    "availability": "AVAILABLE"
                  }
                ]
              }
            }
          },
          "400": {
            "description": "No se admiten parámetros",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INVALID_REQUEST",
                  "message": "No se admiten parámetros"
                }
              }
            }
          },
          "401": {
            "description": "Autenticación requerida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "Autenticación requerida"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servicio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "Error interno del servicio"
                }
              }
            }
          },
          "503": {
            "description": "Proveedor no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "CATALOG_UNAVAILABLE": {
                    "value": {
                      "code": "CATALOG_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  },
                  "AUTH_UNAVAILABLE": {
                    "value": {
                      "code": "AUTH_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wishlist/items/{productId}/add-to-cart": {
      "post": {
        "operationId": "addWishlistItemToCart",
        "tags": [
          "Wishlist"
        ],
        "summary": "Agregar una unidad al carrito conservando el favorito",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Sin cuerpo ni Idempotency-Key. Cada solicitud aceptada agrega una unidad y conserva el favorito. Sin deduplicación durable ni tabla de movimientos. Ante timeout consultar carrito, sin reintentar automáticamente. No confirma reservas ni acredita F-039 original.",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "description": "Identificador textual, no SKU; sin espacios exteriores ni controles."
          }
        ],
        "responses": {
          "200": {
            "description": "Adición confirmada; favorito conservado; Cache-Control: no-store, private.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddFromWishlistResult"
                },
                "example": {
                  "productId": "PRD-1",
                  "cart": {
                    "cartId": "11111111-1111-4111-8111-111111111111",
                    "version": 2,
                    "items": [
                      {
                        "sku": "SKU-SIMPLE",
                        "quantity": 1,
                        "unitPrice": {
                          "amount": 89.9,
                          "currency": "PEN",
                          "version": 1
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Solicitud inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "invalidRequest": {
                    "value": {
                      "code": "INVALID_REQUEST",
                      "message": "Adición inválida"
                    }
                  },
                  "invalidProductId": {
                    "value": {
                      "code": "INVALID_PRODUCT_ID",
                      "message": "Identificador inválido"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Autenticación requerida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "UNAUTHORIZED",
                  "message": "Autenticación requerida"
                }
              }
            }
          },
          "404": {
            "description": "Producto no disponible; favorito conservado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "PRODUCT_NOT_AVAILABLE",
                  "message": "Producto no disponible; favorito conservado"
                }
              }
            }
          },
          "409": {
            "description": "Conflicto; ninguna nueva mutación confirmada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "STOCK_LIMIT_REACHED": {
                    "value": {
                      "code": "STOCK_LIMIT_REACHED",
                      "message": "Adición no confirmada"
                    }
                  },
                  "CART_CONFLICT": {
                    "value": {
                      "code": "CART_CONFLICT",
                      "message": "Adición no confirmada"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Seleccionar variante; favorito conservado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VariantSelectionError"
                },
                "example": {
                  "code": "VARIANT_SELECTION_REQUIRED",
                  "message": "Selecciona una variante",
                  "redirectUrl": "/productos/producto-con-variantes"
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servicio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "Error interno del servicio"
                }
              }
            }
          },
          "503": {
            "description": "Proveedor no disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                },
                "examples": {
                  "CATALOG_UNAVAILABLE": {
                    "value": {
                      "code": "CATALOG_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  },
                  "COMMERCE_DATA_UNAVAILABLE": {
                    "value": {
                      "code": "COMMERCE_DATA_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  },
                  "AUTH_UNAVAILABLE": {
                    "value": {
                      "code": "AUTH_UNAVAILABLE",
                      "message": "Servicio no disponible"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
